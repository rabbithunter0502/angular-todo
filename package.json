{
  "name": "angular-todo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p e2e/tsconfig.json --noEmit"
  },
  "private": true,
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "@angular/common": "22.1.1",
    "@angular/compiler": "22.1.1",
    "@angular/core": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "marked": "^18.0.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.1",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "22.1.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "http-server": "14.1.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "6.0.3",
    "vitest": "^4.0.8"
  }
}
